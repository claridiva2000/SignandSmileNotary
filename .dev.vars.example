# Local secret for the Cloudflare Pages Function (functions/api/contact.ts),
# read by `wrangler pages dev`. Copy this file to `.dev.vars` (gitignored) and
# fill in a real key for local testing. In production this is set as an
# encrypted Secret in the Cloudflare Pages dashboard — see docs/brevo-setup.md.
#
# CONTACT_FROM_EMAIL is not needed here — it's already defined in
# wrangler.toml under [vars], which `wrangler pages dev` reads automatically.

BREVO_API_KEY=your_brevo_api_key
