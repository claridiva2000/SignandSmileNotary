# Formspree endpoint for the contact form (see README "Contact form email delivery").
# Not a secret — this is a public form endpoint, safe to expose in the browser bundle.
# Because the site is a static export, this must be set as a BUILD-TIME environment
# variable (in Cloudflare Pages project settings, or a local .env.local) — it has no
# effect if only set at runtime.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
